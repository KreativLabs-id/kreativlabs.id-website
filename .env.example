# Environment Variables Example
# Copy this file to .env.local and fill in your values

# ================================================
# SITE CONFIGURATION
# ================================================
NEXT_PUBLIC_SITE_URL=https://kreativlabs.id
NEXT_PUBLIC_SITE_NAME=KreativLabs.id

# ================================================
# EMAILJS - SERVER SIDE (Contact Form)
# These are used by app/api/contact/route.ts
# DO NOT prefix with NEXT_PUBLIC_ (security)
# ================================================
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Optional: EmailJS Private Key (if available on your plan)
# EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# Browser fallback used by components/sections/Contact.tsx
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# ================================================
# SECURITY SETTINGS (Recommended for Production)
# ================================================
# Allow additional trusted origins (comma-separated)
# ALLOWED_ORIGINS=https://www.kreativlabs.id,https://kreativlabs.id

# Cloudflare Turnstile (optional, recommended anti-bot)
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# ================================================
# GOOGLE ANALYTICS (Optional)
# ================================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ================================================
# GOOGLE SITE VERIFICATION (Optional)
# ================================================
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_code

# ================================================
# SOCIAL MEDIA LINKS
# ================================================
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/kreativlabs.id
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/kreativlabs
NEXT_PUBLIC_GITHUB_URL=https://github.com/kreativlabs
